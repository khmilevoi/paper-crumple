{
  "name": "@paper-crumple/playground",
  "version": "0.0.0",
  "private": true,
  "description": "A local demo: every paper-crumple knob, live, generated from the runtime descriptors.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -w turbo run build --filter=@paper-crumple/core --filter=@paper-crumple/paper --filter=@paper-crumple/motion --filter=@paper-crumple/react && vite",
    "build": "pnpm -w turbo run build --filter=@paper-crumple/core --filter=@paper-crumple/paper --filter=@paper-crumple/motion --filter=@paper-crumple/react && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project unit"
  },
  "dependencies": {
    "@paper-crumple/core": "workspace:*",
    "@paper-crumple/paper": "workspace:*",
    "@paper-crumple/react": "workspace:*",
    "@paper-crumple/motion": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@paper-crumple/tsconfig": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
