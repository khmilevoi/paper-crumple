{
  "extends": "@paper-crumple/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "vitest.config.ts",
    "eslint.config.js",
    "eslint.boundaries.js",
    "tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tsdown.config.ts",
    "tools/**/*.ts"
  ]
}
