{
  "name": "@paper-crumple/repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project types",
    "test:types": "vitest run --project types",
    "test:gl": "playwright install --no-shell chromium && vitest run --project gl",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:gl",
    "build": "turbo run build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@paper-crumple/tsconfig": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
